/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Reflection {
  user_id       String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  study_year    Int      @db.SmallInt
  study_month   Int      @db.SmallInt
  study_content String   @db.VarChar
  challenge     String   @db.VarChar
  improvement   String   @db.VarChar
  memo          String?  @db.VarChar
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  @@id([user_id, study_year, study_month])
  @@map("振り返り入力テーブル")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model StudyRecord {
  user_id       String      @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  study_date    DateTime    @db.Date
  study_hours   Int
  study_minutes Int
  subject       String      @db.VarChar
  memo          String?     @db.VarChar
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  updated_at    DateTime    @default(now()) @db.Timestamptz(6)
  studyTasks    StudyTask[]

  @@id([user_id, study_date])
  @@map("学習記録入力テーブル")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model StudyTask {
  user_id       String      @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  study_date    DateTime    @db.Date
  study_task_id Int         @db.SmallInt
  study_task    String      @db.VarChar
  is_completed  Boolean
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  updated_at    DateTime    @default(now()) @db.Timestamptz(6)
  studyRecord   StudyRecord @relation(fields: [user_id, study_date], references: [user_id, study_date], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, study_date, study_task_id])
  @@map("本日のタスクテーブル")
}

