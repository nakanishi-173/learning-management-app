model UserGoalContent {
  user_id      String      @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  goal_id      Int         @db.SmallInt
  goal_type    Int         @db.SmallInt
  goal_title   String      @db.VarChar
  goal_subject String      @db.VarChar
  is_completed Boolean
  created_at   DateTime    @default(now()) @db.Timestamptz(6)
  updated_at   DateTime    @default(now()) @db.Timestamptz(6)
  goalSetting  GoalSetting @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, goal_id])
